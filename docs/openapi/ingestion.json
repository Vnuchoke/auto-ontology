{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IngestRequest": {
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "pattern": "\\S",
            "title": "Connection Id",
            "type": "string"
          }
        },
        "required": [
          "connection_id"
        ],
        "title": "IngestRequest",
        "type": "object"
      },
      "SemanticRunningResponse": {
        "additionalProperties": true,
        "description": "The ingestion service's own status endpoint: whether a compilation pass\nis executing right now, when the last one finished successfully, and when\nit last failed (only set if more recent than the last success).",
        "properties": {
          "last_failure_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Failure At"
          },
          "last_success_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success At"
          },
          "running": {
            "title": "Running",
            "type": "boolean"
          }
        },
        "required": [
          "running",
          "last_success_at",
          "last_failure_at"
        ],
        "title": "SemanticRunningResponse",
        "type": "object"
      },
      "StatusResponse": {
        "additionalProperties": true,
        "description": "``{\"status\": \"ok\"}`` or ``{\"status\": \"accepted\"}`` for async triggers.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Auto Ontology Ingestion Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/ingest": {
      "post": {
        "description": "Queue one active source by opaque ID; no credentials or physical-name routing.\n\nValidate metadata before queueing work or opening drivers/models. Unknown\nor inactive IDs return 404, malformed selectors return 422.",
        "operationId": "ingest_connection_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest Connection"
      }
    },
    "/ingest/delete": {
      "post": {
        "description": "Queue final cleanup of one retired source by required opaque connection ID.\n\nNo active-source or credential lookup is performed. Unknown IDs are allowed\nfor idempotent cleanup after root removal; physical-name selectors are rejected.\nA 202 acknowledges queueing, not successful cleanup.",
        "operationId": "ingest_delete_ingest_delete_post",
        "parameters": [
          {
            "in": "query",
            "name": "connection_id",
            "required": true,
            "schema": {
              "pattern": "\\S",
              "title": "Connection Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ingest Delete"
      }
    },
    "/semantic/compile": {
      "post": {
        "description": "Trigger a non-blocking semantic compilation pass.\n\nEnsures the scheduler is running first (``start()`` is idempotent), so this\nalso takes effect when compilation is enabled while the service is already\nup \u2014 no restart needed. Runs on the scheduler's own task; when it finishes,\nthe next automatic run is rescheduled for 24h later.",
        "operationId": "semantic_compile_semantic_compile_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Semantic Compile"
      }
    },
    "/semantic/reset": {
      "post": {
        "description": "Queue a semantic reset by opaque connection ID, or all sources if omitted.\n\nDeletes the semantic nodes and embeddings, then asks for a compilation pass\nso the layer is rebuilt without waiting for the scheduler's next run.\nGlobal PQL vocabulary is preserved. Legacy physical-name selectors are\nrejected rather than silently causing a global reset. A 202 only acknowledges\nqueueing, not successful deletion or rebuild.\n\nThe three steps are strictly ordered \u2014 stop the running pass, wait for it to\nstop, delete, then rebuild \u2014 and run as a background task, so this returns\nimmediately while the wait can take minutes. They used to overlap, which\nlost data in both directions: a pass reads its work list once at the start,\nso one beginning before the delete finished saw every table still carrying a\nTerm and compiled nothing, while a pass still running during the delete kept\nwriting Terms it had already swept past.",
        "operationId": "semantic_reset_semantic_reset_post",
        "parameters": [
          {
            "in": "query",
            "name": "connection_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "\\S",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Connection Id"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Semantic Reset"
      }
    },
    "/semantic/status": {
      "get": {
        "description": "Report whether a compilation pass is executing right now, when the last\none finished successfully, and when it last failed (if that's more recent\nthan the last success).\n\nBacked by the ``semantic_compilation_history`` table (see ``history.py``),\nwhich this service owns \u2014 the Auto Ontology API server relays this response rather\nthan reading that table itself.",
        "operationId": "semantic_status_semantic_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SemanticRunningResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Semantic Status"
      }
    },
    "/semantic/stop": {
      "post": {
        "description": "Ask the in-flight semantic compilation pass to stop.\n\nThe database being compiled finishes first \u2014 that work runs in a thread that\ncannot be interrupted \u2014 so the pass ends at the next database boundary. The\nscheduler stays alive and its next automatic run happens on schedule.",
        "operationId": "semantic_stop_semantic_stop_post",
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Semantic Stop"
      }
    }
  }
}
